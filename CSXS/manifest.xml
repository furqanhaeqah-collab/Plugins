<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.smda.illustrator" ExtensionBundleVersion="1.0.0" ExtensionBundleName="Social Media Design Automation"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.adobe.com/ExtensionManifest">

    <ExtensionList>
        <Extension Id="com.smda.illustrator.panel" Version="1.0.0" />
    </ExtensionList>

    <ExecutionEnvironment>
        <HostList>
            <!-- Illustrator 2020 (24.0) and newer -->
            <Host Name="ILST" Version="[24.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>

    <DispatchInfoList>
        <Extension Id="com.smda.illustrator.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/host.jsx</ScriptPath>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Social Media Automation</Menu>
                    <Geometry>
                        <Size>
                            <Width>400</Width>
                            <Height>760</Height>
                        </Size>
                        <MinSize>
                            <Width>320</Width>
                            <Height>420</Height>
                        </MinSize>
                        <MaxSize>
                            <Width>900</Width>
                            <Height>1400</Height>
                        </MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
